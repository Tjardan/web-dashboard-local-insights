{
  "name": "devpulse-monorepo",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run build:packages && vite",
    "dev:vite": "vite",
    "build": "npm run build:packages && vue-tsc -b && vite build",
    "build:packages": "npm run build --workspace=packages/chat-mcp",
    "build:packages:watch": "npm run build -- --watch --workspace=packages/chat-mcp",
    "preview": "vite preview"
  },
  "dependencies": {
    "vue": "^3.5.13",
    "vue-router": "^4.5.0",
    "pinia": "^2.3.0",
    "@vueuse/core": "^12.0.0"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.2.0",
    "typescript": "~5.7.0",
    "vite": "^6.2.0",
    "vue-tsc": "^2.2.0",
    "@types/node": "^22.0.0"
  }
}
