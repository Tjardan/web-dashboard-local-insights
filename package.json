{
  "name": "devpulse-monorepo",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run build:packages && vite",
    "dev:vite": "vite",
    "build": "npm run build:packages && vue-tsc -b && vite build",
    "build:packages": "npm run build --workspace=packages/search-shared && npm run build --workspace=packages/chat-mcp && npm run sync:packages",
    "sync:packages": "node -e \"const{cpSync}=require('fs');['search-shared','chat-mcp'].forEach(p=>{try{cpSync('packages/'+p+'/dist','node_modules/@devpulse/'+p+'/dist',{recursive:true,force:true});}catch(e){}});console.log('dist synced to node_modules');\"",
    "build:packages:watch": "npm run build -- --watch --workspace=packages/search-shared & npm run build -- --watch --workspace=packages/chat-mcp",
    "preview": "vite preview"
  },
  "dependencies": {
    "@devpulse/search-shared": "*",
    "@github/copilot-sdk": "^0.1.30",
    "@vueuse/core": "^12.0.0",
    "pinia": "^2.3.0",
    "vue": "^3.5.13",
    "vue-router": "^4.5.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@vitejs/plugin-vue": "^5.2.0",
    "typescript": "~5.7.0",
    "vite": "^6.2.0",
    "vue-tsc": "^2.2.0"
  }
}
